server {
    listen 80;
    server_name ${APP_DOMAIN};
    server_tokens off;

    # For letsencrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
        default_type "text/plain";
    }

    location / {
        return 301 https://${APP_DOMAIN};
    }
}

server {
    client_max_body_size 128M;
    listen 443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/nginx/ssl/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${APP_DOMAIN}/privkey.pem;

    # Disable caching for index.html
    location = /index.html {
        root /var/www/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Static files
    location / {
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Apps directory listing
    location /apps/ {
        root /var/www/html;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }

    # WebSocket
    location /ws {
        proxy_pass http://api_server:8080/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    error_log /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
}
