# localhost - локально; example.com - прод (A-запись DNS на этот сервер)
DOMAIN=localhost

# Let's Encrypt на проде (на localhost не используется)
ACME_EMAIL=admin@example.com

# IP для WebRTC ICE: 127.0.0.1 локально, публичный IP сервера на проде
MEDIA_IP=192.168.1.101

# Число SFU-воркеров (UDP 3478 .. 3478+WORKER_COUNT-1, макс. 16)
WORKER_COUNT=4

# Лимит одновременных WS-подключений к SFU
MAX_CLIENTS=10000

# Прод (Linux): раскомментируй - host network для WebRTC UDP
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
